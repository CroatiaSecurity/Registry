Windows Registry Editor Version 5.00

; =============================================================================
; Performance & Responsiveness Tweaks (merged from Perf1/2/3 + Asc)
; =============================================================================

; --- Desktop Responsiveness ---
[HKEY_CURRENT_USER\Control Panel\Desktop]
"MenuShowDelay"="0"
"ForegroundLockTimeout"=dword:000249f0
"ActiveWndTrkTimeout"=dword:00000000
"HungAppTimeout"="4000"
"WaitToKillAppTimeout"="5000"
"AutoEndTasks"="1"

[HKEY_CURRENT_USER\Control Panel\Mouse]
"MouseHoverTime"="100"

; --- Game Mode ---
[HKEY_CURRENT_USER\Software\Microsoft\GameBar]
"AllowAutoGameMode"=dword:00000001

; --- Explorer Tweaks ---
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer]
"link"=hex(3):00,00,00,00
"EnableAutoTray"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"EnableBalloonTips"=dword:00000001
"DesktopLivePreviewHoverTime"=dword:00000000
"StartButtonBalloonTip"=dword:00000001
"NoNetCrawling"=dword:00000001
"ListviewAlphaSelect"=dword:00000000
"TaskbarAnimations"=dword:00000000
"TaskbarGlomming"=dword:00000001
"TaskbarSi"=dword:00000000
"TaskbarGlomLevel"=dword:00000000
"TaskbarGroupSize"=dword:00000000
"PersistBrowsers"=dword:00000000

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\VirtualDesktops]
"VDSoftLandingCampaignDone"=dword:00000001

; --- Visual Effects (custom) ---
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects]
"VisualFXSetting"=dword:00000003

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects\CursorShadow]
"DefaultApplied"=dword:00000000

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects\DropShadow]
"DefaultApplied"=dword:00000000

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects\MenuAnimation]
"DefaultApplied"=dword:00000000

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects\TaskbarAnimations]
"DefaultApplied"=dword:00000000

; --- Clear MRU history ---
[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\ComDlg32\LastVisitedPidlMRU]

[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\TypedPaths]

; --- Internet Connection Limits ---
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Internet Settings]
"MaxConnectionsPer1_0Server"=dword:0000000a
"MaxConnectionsPerServer"=dword:0000000a

; --- Explorer Policies ---
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer]
"NoSimpleNetIDList"=dword:00000001
"NoDriveTypeAutoRun"=dword:000000dd
"NoCDBurning"=dword:00000000
"NoRecentDocsHistory"=dword:00000000
"ClearRecentDocsOnExit"=dword:00000000

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Policies\Network]
"NoWorkgroupContents"=dword:00000001

; --- IE Update Check ---
[HKEY_CURRENT_USER\Software\Microsoft\Internet Explorer\Main]
"NoUpdateCheck"=dword:00000001

; =============================================================================
; HKLM — System Performance
; =============================================================================

; --- Boot Optimization ---
[HKEY_LOCAL_MACHINE\Software\Microsoft\Dfrg\BootOptimizeFunction]
"Enable"="Y"

[HKEY_LOCAL_MACHINE\Software\WOW6432Node\Microsoft\Dfrg\BootOptimizeFunction]
"Enable"="Y"

; --- Connection Limits (IE/Explorer) ---
[HKEY_LOCAL_MACHINE\Software\Microsoft\Internet Explorer\MAIN\FeatureControl\FEATURE_MAXCONNECTIONSPER1_0SERVER]
"iexplore.exe"=dword:0000000a
"explorer.exe"=dword:0000000a

[HKEY_LOCAL_MACHINE\Software\Microsoft\Internet Explorer\MAIN\FeatureControl\FEATURE_MAXCONNECTIONSPERSERVER]
"iexplore.exe"=dword:0000000a
"explorer.exe"=dword:0000000a

[HKEY_LOCAL_MACHINE\Software\WOW6432Node\Microsoft\Internet Explorer\MAIN\FeatureControl\FEATURE_MAXCONNECTIONSPER1_0SERVER]
"iexplore.exe"=dword:0000000a

[HKEY_LOCAL_MACHINE\Software\WOW6432Node\Microsoft\Internet Explorer\MAIN\FeatureControl\FEATURE_MAXCONNECTIONSPERSERVER]
"iexplore.exe"=dword:0000000a

; --- MSMQ TCP NoDelay ---
[HKEY_LOCAL_MACHINE\Software\Microsoft\MSMQ\Parameters]
"TCPNoDelay"=dword:00000001

; --- Multimedia / Scheduling ---
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile]
"SystemResponsiveness"=dword:00000000
"NetworkThrottlingIndex"=dword:00ffffff

[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Audio]
"Scheduling Category"="High"
"SFIO Priority"="High"
"GPU Priority"=dword:00000002
"Priority"=dword:00000001
"Clock Rate"=dword:00000a96

[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games]
"SFIO Priority"="High"
"Background Only"="True"
"Scheduling Category"="High"

[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Low Latency]
"Latency Sensitive"="True"
"GPU Priority"=dword:00000002
"Clock Rate"=dword:00000a96
"Scheduling Category"="High"
"SFIO Priority"="High"
"Background Only"="False"
"Priority"=dword:00000001

[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Pro Audio]
"Clock Rate"=dword:00000a96
"SFIO Priority"="High"
"GPU Priority"=dword:00000002

; --- Delivery Optimization Off ---
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\DeliveryOptimization\Config]
"DownloadMode"=dword:00000000

; --- Always Unload DLLs ---
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Explorer]
"AlwaysUnloadDLL"=dword:00000001

; --- Max Cached Icons ---
[HKEY_LOCAL_MACHINE\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Explorer]
"Max Cached Icons"=dword:000007d0
"GlobalAssocChangedCounter"=dword:0000000f

; --- Disable Error Reporting ---
[HKEY_LOCAL_MACHINE\Software\Microsoft\PCHealth\ErrorReporting]
"DoReport"=dword:00000000
"ShowUI"=dword:00000000

[HKEY_LOCAL_MACHINE\Software\WOW6432Node\Microsoft\PCHealth\ErrorReporting]
"DoReport"=dword:00000000
"ShowUI"=dword:00000000

; --- Disable Auto Debugger ---
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\AeDebug]
"Auto"="0"

[HKEY_LOCAL_MACHINE\Software\WOW6432Node\Microsoft\Windows NT\CurrentVersion\AeDebug]
"Auto"="0"

; --- Winlogon ---
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Winlogon]
"AllocateFloppies"="1"
"IgnoreShiftOverride"="1"
"AllocateCDRoms"="1"
"AllowMultipleTSSessions"=dword:00000001

[HKEY_LOCAL_MACHINE\Software\WOW6432Node\Microsoft\Windows NT\CurrentVersion\Winlogon]
"AutoRestartShell"=dword:00000001

; --- Advertising / Privacy ---
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\AdvertisingInfo]
"Enabled"=dword:00000000

; --- QoS / Bandwidth ---
[HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\Psched]
"NonBestEffortLimit"=dword:00000000
"MaxOutstandingSends"=dword:0000ffff

; --- Policies ---
[HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Biometrics]
"Enabled"=dword:00000000

[HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Biometrics\FacialFeatures]
"EnhancedAntiSpoofing"=dword:00000001

[HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Internet Explorer\Infodelivery\Restrictions]
"NoUpdateCheck"=dword:00000001

[HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\Registration Wizard Control]
"NoRegistration"=dword:00000001

[HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\WindowsUpdate\AU]
"NoAutoRebootWithLoggedOnUsers"=dword:00000001

[HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\TabletPC]
"PreventHandwritingDataSharing"=dword:00000001

[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\Network]
"NoWorkgroupContents"=dword:00000001

; --- Remove stale WMI tracing ---
[-HKEY_LOCAL_MACHINE\Software\Microsoft\Wbem\Tracing\Providers\CIMWin32 @ root/CIMV2]

[-HKEY_LOCAL_MACHINE\Software\Microsoft\Wbem\Tracing\Providers\NetAdapterCim @ ROOT/StandardCimv2]

