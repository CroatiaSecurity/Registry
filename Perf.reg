; --- Registered Organization ---
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion]
"RegisteredOrganization"=""

; =============================================================================
; SYSTEM — Kernel, Memory, Filesystem, Network
; =============================================================================

; --- Process Priority ---
[HKEY_LOCAL_MACHINE\System\ControlSet001\Control\PriorityControl]
"Win32PrioritySeparation"=dword:00000026

; --- Filesystem ---
[HKEY_LOCAL_MACHINE\System\ControlSet001\Control\FileSystem]
"NTFSDisableLastAccessUpdate"=dword:80000003

; --- Memory Management ---
[HKEY_LOCAL_MACHINE\System\ControlSet001\Control\Session Manager\Memory Management]
"DisablePagingExecutive"=dword:00000001
"ClearPageFileAtShutdown"=dword:00000000

[HKEY_LOCAL_MACHINE\System\ControlSet001\Control\Session Manager\Memory Management\PrefetchParameters]
"EnablePrefetcher"=dword:00000003
"EnableSuperFetch"=dword:00000003
"EnableBoottrace"=dword:00000001

; --- Session Manager ---
[HKEY_LOCAL_MACHINE\System\ControlSet001\Control\Session Manager]
"CWDIllegalInDllSearch"=dword:00000002

; --- Environment (Device Manager show all) ---
[HKEY_LOCAL_MACHINE\System\ControlSet001\Control\Session Manager\Environment]
"DEVMGR_SHOW_DETAILS"="1"
"DEVMGR_SHOW_NONPRESENT_DEVICES"="1"

; --- Remote Registry Access ---
[HKEY_LOCAL_MACHINE\System\ControlSet001\Control\SecurePipeServers\winreg]
"RemoteRegAccess"=dword:00000001

; --- Network Provider ---
[HKEY_LOCAL_MACHINE\System\ControlSet001\Control\NetworkProvider]
"RestoreConnection"=dword:00000001

; --- Power / Hibernate ---
[HKEY_LOCAL_MACHINE\System\ControlSet001\Control\Power]
"HibernateEnabled"=dword:00000001

; --- Terminal Server ---
[HKEY_LOCAL_MACHINE\System\ControlSet001\Control\Terminal Server]
"fAllowFullControl"=dword:00000000

; --- USB Idle ---
[HKEY_LOCAL_MACHINE\System\ControlSet001\Control\Class\{36fc9e60-c465-11cf-8056-444553540000}\0000]
"IdleEnable"=dword:00000001

; --- TCP/IP Performance ---
[HKEY_LOCAL_MACHINE\System\ControlSet001\Services\Tcpip\Parameters]
"SackOpts"=dword:00000001
"EnablePMTUBHDetect"=dword:00000001
"EnablePMTUDiscovery"=dword:00000001
"GlobalMaxTcpWindowSize"=dword:000016b0
"Tcp1323Opts"=dword:00000003
"TcpWindowSize"=dword:000016b0
"TcpMaxDupAcks"=dword:00000002
"MaxConnectionsPerServer"=dword:00000000
"DefaultTTL"=dword:00000040

[HKEY_LOCAL_MACHINE\System\ControlSet001\Services\Tcpip\Parameters\Interfaces]
"TCPNoDelay"=dword:00000001
"TcpAckFrequency"=dword:00000001

; --- SMB / LanmanServer ---
[HKEY_LOCAL_MACHINE\System\ControlSet001\Services\LanmanServer\Parameters]
"SizReqBuf"=dword:00004000
"AutoShareServer"=dword:00000000

; --- SMB / LanmanWorkstation ---
[HKEY_LOCAL_MACHINE\System\ControlSet001\Services\LanmanWorkstation\Parameters]
"MaxCmds"=dword:0000001e
"MaxCollectionCount"=dword:00000020
"MaxThreads"=dword:0000001e

; --- NVIDIA Lid Close ---
[HKEY_LOCAL_MACHINE\System\ControlSet001\Services\nvlddmkm\Global\NVTweak]
"LidCloseAction"=dword:00000000

